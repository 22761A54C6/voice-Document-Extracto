# =============================================================================
# Voice AI Service -- environment configuration
# Copy to .env and fill in the REQUIRED values. Never commit .env.
# =============================================================================

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8002
# true only for local development (auto-restart on code changes)
RELOAD=false

# --- Logging -----------------------------------------------------------------
# INFO  = one request line + one result line per request (production)
# DEBUG = every pipeline step, transcript, raw LLM output (troubleshooting)
LOG_LEVEL=INFO
# text = human-readable lines; json = one JSON object per line (ELK, Loki, CloudWatch, Datadog)
LOG_FORMAT=text
FASTER_WHISPER_LOG_LEVEL=WARNING

# --- Gemini (REQUIRED) -------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# Turns the transcript into products
GEMINI_MODEL=gemini-3.5-flash-lite
# Must match the Image-Text-Pdf service (it embeds the shared categories)
GEMINI_EMBED_MODEL=gemini-embedding-001
# "minimal" is fastest. For models that reject thinking levels (e.g. gemini-3.8-flash)
# remove this line and set GEMINI_THINKING_BUDGET=0 instead.
GEMINI_THINKING_LEVEL=minimal
GEMINI_TEMPERATURE=0
GEMINI_TIMEOUT_MS=120000

# --- MongoDB Atlas (REQUIRED) ------------------------------------------------
# Same cluster + database as the Image-Text-Pdf service
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=bizlink_ollama

# --- Uploads -----------------------------------------------------------------
MAX_FILE_SIZE_MB=5

# --- Speech-to-text (faster-whisper, runs locally) ---------------------------
# small = good accuracy on CPU; base = ~2x faster, less accurate
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
# Skip silence before transcribing
WHISPER_VAD_FILTER=true
# Empty = auto-detect; set e.g. en to skip language detection (faster)
WHISPER_LANGUAGE=
# Unset = all CPU cores; lower it if other services share the machine
# WHISPER_CPU_THREADS=4

# --- Category matching (index is created by the Image-Text-Pdf service) ------
VECTOR_SEARCH_NUM_CANDIDATES=768
